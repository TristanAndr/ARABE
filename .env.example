# Copier ce fichier vers .env.local (ignoré par Git) et le compléter.
# Valeurs : dashboard Supabase > Project Settings > API Keys (et Data API pour l'URL).

# URL du projet, par exemple https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clé « publishable » (sb_publishable_…), faite pour être publique : la sécurité repose sur la RLS.
# Ne JAMAIS mettre ici la clé secrète (sb_secret_…) ni la clé service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Facultatif, uniquement pour `npm run check:rls` (deux comptes de test confirmés).
# RLS_A_EMAIL=
# RLS_A_PASSWORD=
# RLS_B_EMAIL=
# RLS_B_PASSWORD=
